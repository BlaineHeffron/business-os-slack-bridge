# Copy to .env (or export in launchd plist). Bridge reads process env only.

# Slack app (Socket Mode: no public ingress needed)
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...          # app-level token with connections:write
SLACK_CHANNEL_ID=C0123456789      # channel (or DM id) where proposal cards are posted
SLACK_APPROVER_USER_IDS=U0AAAAAAA # comma-separated Slack user ids whose clicks count

# BusinessOS
BOS_URL=http://127.0.0.1:8080
BOS_OPERATOR_TOKEN=...            # value of BOS_OPERATOR_TOKEN on the bos-server

# Bridge
POLL_INTERVAL_MS=15000
STATE_FILE=./state.json          # absolute path under a protected dir in production
READINESS_PORT=8091

# Optional sitemap discovery. The first scan only saves a baseline.
# New URLs between the two markers start BusinessOS social drafting.
SITEMAP_URL=
SITEMAP_START_MARKER=
SITEMAP_END_MARKER=
SITEMAP_PUBLIC_BASE_URL=
SITEMAP_POLL_INTERVAL_MS=300000
